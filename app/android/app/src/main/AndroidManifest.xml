<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter's debug/profile manifest variants add this automatically
         (for the VM service), which is why this was never missed while
         testing with `flutter run` - but a release build only uses this
         main manifest, so without it a release APK has no network access
         at all. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ requires this to be granted at runtime before any
         notification (including FCM's) can show — requested explicitly
         in push_service.dart rather than assumed, since the OS treats
         it exactly like any other dangerous permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lets a high-priority FCM message wake the device to show the
         notification promptly instead of waiting for the next Doze
         maintenance window — the difference between "message arrives
         now" and "message arrives whenever the phone happens to wake up". -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="Hearth"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- The channel a background/terminated notification posts to when
             the OS displays it without any app code running — must match
             `channel_id` in the FCM payload (see
             `backend/crates/push/src/lib.rs`) and the channel
             push_service.dart creates on launch, or Android silently
             drops the notification instead of showing it. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mental_ai_messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets the chat crisis banner's "112'yi ara" button actually open
             the dialer via url_launcher's tel: scheme — without this,
             Android 11+'s package-visibility rules make the dialer
             invisible to the app and the button silently does nothing. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
