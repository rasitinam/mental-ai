<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's own privacy manifest. It mirrors the App Privacy answers in
  App Store Connect (every type linked to the account, used only for app
  functionality, never for tracking) and the Privacy Policy. Plugins ship
  their own manifests for the APIs they use.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
